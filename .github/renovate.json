{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "enabledManagers": ["pub", "fvm", "github-actions", "bundler", "custom.regex"],
  "ignorePaths": ["packages/**"],
  "labels": ["deps"],
  "minimumReleaseAge": "2 days",
  "constraints": {
    "flutter": "3.47.6"
  },
  "customManagers": [
    {
      "description": "Keep the Flutter version used for pubspec.lock updates in sync with .fvmrc",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/renovate\\.json$/"],
      "matchStrings": ["\"flutter\": \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "flutter",
      "datasourceTemplate": "flutter-version"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["slang*"],
      "groupName": "slang"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["drift*", "!drift_db_viewer"],
      "groupName": "drift"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["go_router*"],
      "groupName": "go_router"
    },
    {
      "description": "Update .fvmrc and constraints.flutter together in a dedicated PR",
      "matchDepNames": ["flutter"],
      "groupName": "flutter"
    },
    {
      "matchManagers": ["bundler"],
      "groupName": "gems"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-8 * * 1"]
  }
}
