{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "enabledManagers": ["pub", "fvm", "github-actions", "bundler", "custom.regex", "gradle", "gradle-wrapper"],
  "ignorePaths": ["packages/**"],
  "minimumReleaseAge": "2 days",
  "prHourlyLimit": 0,
  "group": {
    "commitMessageTopic": "{{{groupName}}}{{#with (distinct (lookupArray upgrades \"depName\"))}}{{#unless (equals length 1)}} ({{length}} packages){{/unless}}{{/with}}"
  },
  "commitBodyTable": true,
  "customManagers": [
    {
      "description": "Keep the Flutter SDK path in the VS Code settings in sync with .fvmrc",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.vscode/settings\\.json$/"],
      "matchStrings": ["\\.fvm/versions/(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "flutter",
      "datasourceTemplate": "flutter-version"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch"
    },
    {
      "description": "Temporary: build_runner >=2.17 requires build 5, which freezed does not support yet. Keep it out of the minor and patch group so the other updates can be merged. Remove once freezed supports build 5",
      "matchPackageNames": ["build_runner"],
      "groupName": "build_runner"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["slang*"],
      "groupName": "slang"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["drift*", "!drift_db_viewer"],
      "groupName": "drift"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["go_router*"],
      "groupName": "go_router"
    },
    {
      "description": "Update every file pinning the Flutter version in a single PR",
      "matchDepNames": ["flutter"],
      "groupName": "flutter"
    },
    {
      "matchManagers": ["bundler"],
      "groupName": "gems"
    },
    {
      "description": "CI does not build Android, so create these PRs only on approval",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "android",
      "addLabels": ["deps:android"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Gradle plugins bundled with the Flutter SDK, not published to any repository",
      "matchDepNames": ["dev.flutter.*"],
      "enabled": false
    },
    {
      "matchManagers": ["pub"],
      "addLabels": ["deps:pub"]
    },
    {
      "matchManagers": ["fvm", "custom.regex"],
      "addLabels": ["deps:flutter"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["deps:workflow"]
    },
    {
      "matchManagers": ["bundler"],
      "addLabels": ["deps:gem"]
    },
    {
      "description": "Regenerate code once per branch. Branch mode takes the tasks of the first upgrade only, so match every manager that can share a branch with pub. Flutter updates are excluded: installing another version would desync the Flutter that Renovate believes is active",
      "matchManagers": ["pub", "github-actions"],
      "matchDepNames": ["!flutter"],
      "postUpgradeTasks": {
        "commands": ["./scripts/ci_codegen.sh"],
        "executionMode": "branch"
      }
    }
  ]
}
